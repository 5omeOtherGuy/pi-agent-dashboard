{
  "name": "pi-agent-dashboard",
  "version": "0.1.0",
  "description": "Personal project: a dashboard and supervisor for long-lived Pi worker agents, driven from any Pi session or tmux.",
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "subagent",
    "orchestration",
    "dashboard",
    "supervisor"
  ],
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "bin": {
    "pi-orch": "./bin/pi-orch.mjs"
  },
  "pi": {
    "extensions": [
      "./extensions"
    ]
  },
  "files": [
    "bin",
    "src",
    "extensions",
    "README.md",
    "docs"
  ],
  "scripts": {
    "test": "node --test \"test/*.test.ts\"",
    "check": "tsc --noEmit",
    "gate": "tsc --noEmit && node --test --test-reporter=dot \"test/*.test.ts\" && secretlint --secretlintignore .gitignore \"**/*\" && npm pack --dry-run --silent > /dev/null"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "^1.3.30"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.3.0",
    "@earendil-works/pi-tui": "^1.3.0",
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.7",
    "@types/node": "^24.0.0",
    "secretlint": "^13.0.7",
    "typebox": "^1.4.2",
    "typescript": "^5.6.0"
  }
}
